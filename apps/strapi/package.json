{
  "name": "@repo/strapi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "prebuild": "[ -n \"$STRAPI_CI\" ] && cd ../.. && pnpm exec turbo run build --filter=@repo/strapi^... || true",
    "build": "strapi build",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "dev": "pnpm run run:db && pnpm run develop",
    "develop": "strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "generate": "strapi generate",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix",
    "run:db": "docker compose up -d db",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "vitest run",
    "test:watch": "vitest",
    "transfer": "strapi transfer",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/shared-data": "workspace:*",
    "@strapi/database": "5.36.0",
    "@strapi/design-system": "2.1.2",
    "@strapi/plugin-color-picker": "5.36.0",
    "@strapi/plugin-sentry": "5.36.0",
    "@strapi/plugin-users-permissions": "5.36.0",
    "@strapi/provider-email-mailgun": "5.36.0",
    "@strapi/provider-email-nodemailer": "5.36.0",
    "@strapi/provider-upload-aws-s3": "5.36.0",
    "@strapi/strapi": "catalog:",
    "@strapi/utils": "5.36.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "catalog:",
    "nodemailer": "^7.0.12",
    "pg": "^8.13.1",
    "qs": "catalog:",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-config-sync": "2.1.0",
    "styled-components": "^6.0.0",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "catalog:",
    "vite": "^5.4.0"
  },
  "strapi": {
    "uuid": "@repo/strapi"
  }
}
