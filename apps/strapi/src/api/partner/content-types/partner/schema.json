{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "label": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "richtext"
    },
    "logo": {
      "type": "component",
      "component": "media.image",
      "repeatable": false
    },
    "level": {
      "type": "enumeration",
      "enum": ["community", "business", "enterprise"]
    },
    "type": {
      "type": "enumeration",
      "enum": ["solution-partner", "technology-partner"]
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "country": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::country.country"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::partner-service.partner-service"
    },
    "techStacks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tech-stack.tech-stack"
    },
    "cta": {
      "type": "component",
      "component": "utilities.link",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "seo-utilities.seo",
      "repeatable": false
    },
    "content": {
      "type": "richtext"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.section-header",
        "sections.faq-section",
        "sections.two-columns-benefits",
        "sections.two-column-grid",
        "cards.content-card",
        "media.image",
        "media.image-gallery",
        "media.video",
        "testimonials.quote",
        "sections.testimonies",
        "forms.newsletter",
        "forms.hubspot-form",
        "migration.data-sink"
      ]
    }
  }
}
