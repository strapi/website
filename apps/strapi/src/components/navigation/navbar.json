{
  "collectionName": "components_navigation_navbars",
  "info": {
    "displayName": "Navbar",
    "icon": "squaresFour",
    "description": "Main navigation bar with logo, nav items, and CTA links"
  },
  "attributes": {
    "logoImage": {
      "type": "component",
      "component": "utilities.link-image",
      "repeatable": false
    },
    "logoImageLight": {
      "type": "component",
      "component": "utilities.link-image",
      "repeatable": false
    },
    "navItems": {
      "type": "component",
      "component": "navbar.nav-item",
      "repeatable": true
    },
    "bottomLinks": {
      "type": "component",
      "component": "utilities.link",
      "repeatable": true
    },
    "ctaLinks": {
      "type": "component",
      "component": "utilities.link",
      "repeatable": true
    },
    "githubStars": {
      "type": "boolean",
      "default": true
    },
    "githubUrl": {
      "type": "string",
      "default": "https://github.com/strapi/strapi",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "githubStars"
            },
            true
          ]
        }
      }
    },
    "mediaKit": {
      "type": "component",
      "component": "navigation.media-kit",
      "repeatable": false
    }
  }
}
