{
  "collectionName": "components_cards_feature_card",
  "info": {
    "displayName": "FeatureCard",
    "icon": "spark",
    "description": ""
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "richtext"
    },
    "icon": {
      "type": "component",
      "repeatable": false,
      "component": "utilities.basic-image"
    },
    "image": {
      "type": "component",
      "repeatable": false,
      "component": "utilities.basic-image"
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": ["left", "right"],
      "default": "right"
    },
    "variant": {
      "type": "enumeration",
      "enum": ["plain", "bordered"],
      "default": "plain"
    },
    "size": {
      "type": "enumeration",
      "enum": ["sm", "default", "lg"],
      "default": "default"
    },
    "layout": {
      "type": "enumeration",
      "enum": ["full", "half", "third"],
      "default": "full"
    },
    "ctaLinks": {
      "type": "component",
      "repeatable": true,
      "component": "utilities.link"
    }
  }
}
