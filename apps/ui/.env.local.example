# copy & rename to .env.local
#
# Do not leave empty values, e.g. `NEXT_OUTPUT=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# -------------------------- Next.js settings ---------------------------------

# See next.config.js's "output" option. Possible values:
# - "standalone" - docker container
# - "export" - static export
# - undefined - default, `next start`
NEXT_OUTPUT=standalone

# Enable logging of generateStaticParams output during build time by segment
# DEBUG_STATIC_PARAMS_GENERATION=true

# Enable showing of non-blocking errors in the UI (very chattery logs)
# SHOW_NON_BLOCKING_ERRORS=true

# Enable logging of Strapi Client API calls (very chattery logs)
# DEBUG_STRAPI_CLIENT_API_CALLS=true

# Environment the app is running in (controls deployment-specific behavior)
# APP_ENV=testing

# -------------------------- Strapi connection ---------------------------------

# URL of Strapi
STRAPI_URL=http://127.0.0.1:1337

# Origin of the Strapi media CDN (server-side only). Used only to emit a
# `preconnect` resource hint so the LCP hero media starts loading sooner. Set to
# the media subdomain of your Strapi Cloud project. Leave unset to skip the hint.
# STRAPI_MEDIA_URL=https://<project>.media.strapiapp.com

# Read Only API KEY generated within Strapi, providing access to find and findOne endpoints
STRAPI_REST_READONLY_API_KEY=

# API KEY with custom permissions, providing different access to Strapi endpoints
# STRAPI_REST_CUSTOM_API_KEY=

# Strapi Preview shared secret (must match STRAPI_PREVIEW_SECRET in Strapi's .env)
STRAPI_PREVIEW_SECRET=your-secret-key

# Shared secret for Strapi → Next.js cache revalidation webhook
# (must match STRAPI_REVALIDATE_SECRET in apps/strapi/.env)
STRAPI_REVALIDATE_SECRET=your-revalidate-secret

# -------------------------- AWS CloudFront ---------------------------------

# CloudFront cache invalidation on revalidation (production only).
# Disabled when the distribution ID is unset. Credentials via the SDK
# provider chain — IAM role, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# AWS_CLOUDFRONT_DISTRIBUTION_ID=
# AWS_REGION=us-east-1

# -------------------------- Sentry ---------------------------------

# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Suppresses Sentry's global error handler file warning in Next.js
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# -------------------------- ReCAPTCHA v3 ---------------------------------

# Google test keys (always pass, score=1.0) — replace with real keys for production
# Get real keys at: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# -------------------------- Basic Auth ---------------------------------

# Enable HTTP Basic Authentication (e.g. for staging environments)
# BASIC_AUTH_ENABLED=true
# BASIC_AUTH_USERNAME=
# BASIC_AUTH_PASSWORD=

# -------------------------- App settings ---------------------------------

# Canonical URL of site — used for sitemap, SEO canonical tags, etc.
APP_PUBLIC_URL=http://localhost:3000

# ISR revalidation interval (seconds) for static pages. Defaults to 4h when unset.
# DEFAULT_REVALIDATE_TIME=14400

# Suppress warnings for page-builder components not marked as used
# NEXT_PUBLIC_PREVENT_UNUSED_FUNCTIONS_ERROR_LOGS=true

# -------------------------- Chargebee ---------------------------------

# Chargebee hosted pages base URL (required for pricing checkout)
# NEXT_PUBLIC_CHARGEBEE_URL=https://your-site.chargebee.com

# -------------------------- HubSpot / Analytics ---------------------------------

HUBSPOT_API_TOKEN=

# GTM_ID=GTM-XXXXXXX
# HUBSPOT_PORTAL_ID=00000000
# HOTJAR_ID=0000000

# Cookiebot consent banner — your CBID from https://manage.cookiebot.com/
# COOKIEBOT_ID=00000000-0000-0000-0000-000000000000

# Kapa AI support widget — website/integration ID from the Kapa dashboard
# (Widget → Installation). https://docs.kapa.ai/integrations/website-widget
# KAPA_WEBSITE_ID=

# -------------------------- Meilisearch ---------------------------------

# Meilisearch host URL (server-side only — never exposed to the browser).
MEILISEARCH_HOST=http://localhost:7700
# Host URL for docs
MEILISEARCH_DOCS_HOST=

# API key with read access on the indexes consumed by the UI.
MEILISEARCH_API_KEY=
# API key with read access to the Strapi documentation
MEILISEARCH_DOCS_API_KEY=

# Toggles which env's indexes the UI reads from.
# true  -> *-production indexes
# false -> *-testing indexes
MEILISEARCH_PRODUCTION=false

# -------------------------- Demo provisioning ---------------------------------

# Demo operator service URL and auth token (for /demo page form provisioning)
# DEMO_OPERATOR_SERVER=http://localhost:3005
# DEMO_OPERATOR_TOKEN=
# HUBSPOT_DEMO_WORKFLOW_ID=
