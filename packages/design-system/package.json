{
  "name": "@repo/design-system",
  "version": "1.0.0",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./styles.css": "./dist/styles.css",
    "./custom-styles.css": "./src/custom-styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint -c ../../eslint.config.mjs './**/*.{js,ts,jsx,tsx,cjs,mjs}'",
    "lint:fix": "pnpm lint --fix"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "catalog:",
    "class-variance-authority": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "postcss-modules-values": "^4.0.0"
  }
}
