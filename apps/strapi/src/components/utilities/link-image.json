{
  "collectionName": "components_utilities_link_images",
  "info": {
    "displayName": "LinkImage",
    "icon": "images"
  },
  "options": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "page",
      "enum": [
        "external",
        "page"
      ]
    },
    "label": {
      "type": "string"
    },
    "newTab": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "href": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "external"
          ]
        }
      },
      "required": true
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "page"
          ]
        }
      }
    },
    "image": {
      "type": "component",
      "component": "utilities.basic-image",
      "repeatable": false
    }
  }
}
