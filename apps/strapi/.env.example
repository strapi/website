# Tweak for your needs and rename to .env
#
# Do not leave empty values, e.g. `DATABASE_PASSWORD=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# ----- Strapi general -----

# The host where Strapi will listen.
HOST=0.0.0.0

# The port where Strapi will listen.
PORT=1337

# The secret keys used to sign the session cookies.
APP_KEYS=l8ftzyp2hNmEtNXBYU5hhQ==,lH7EcVVZxIoTFRorjrV9Vw==,jxWii7EjavRgJ4jYPZ60hA==,FlZM4tyij/HDFcKZhsmlXQ==

# The secret used to sign the API tokens.
API_TOKEN_SALT=usReW/cYjLHmpLEoRnWf+g==

# The secret used to sign the JWT for the Admin panel.
ADMIN_JWT_SECRET=Xw39b/xXxEHW1x1WMM6ugQ==

# The secret used to sign the JWT for the Users-Permissions plugin
JWT_SECRET=ShuOcfjTi/RwcchWEIKYKA==

# Sets the public URL of the application (usually related to production deploy).
# Also used to build the admin SSO callback URL (<APP_URL>/admin/connect/google).
APP_URL=http://localhost:1337

# ----- Admin SSO (Google) -----

# Google OAuth client credentials for admin-panel Single Sign-On (Enterprise).
# When both are set, a "Sign in with Google" button appears on /admin login.
# Authorized redirect URI in Google Cloud must be: <APP_URL>/admin/connect/google
# Leave commented locally to keep plain email/password login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ----- Database -----

# The database client to use.
DATABASE_CLIENT=postgres

# The database host.
DATABASE_HOST=0.0.0.0

# The database port.
DATABASE_PORT=5432

# The database name.
DATABASE_NAME=strapi-db

# The database username.
DATABASE_USERNAME=admin

# The database password.
DATABASE_PASSWORD=mFm8z7z8

# Enable SSL support.
DATABASE_SSL=false

# ----- Sentry -----

# SENTRY_DSN=

# ----- Strapi Preview -----

# Base URL of the frontend. Required for Strapi Preview.
# IMPORTANT (production): must point at a domain that BYPASSES CloudFront
# (e.g. the Vercel origin domain, not strapi.io). CloudFront does not key its
# cache on the __prerender_bypass cookie and enforces a minimum TTL, so a
# CDN-fronted preview serves stale published HTML to editors and can cache
# draft renders for anonymous visitors. The revalidation webhook
# (/api/strapi-revalidate POST) is also blocked by the CDN.
CLIENT_URL=http://localhost:3000

# Strapi Preview toggle. Values "true" => enabled, else disabled.
STRAPI_PREVIEW_ENABLED=true

# Shared secret for frontend and backend that enables draft mode.
STRAPI_PREVIEW_SECRET=your-secret-key

# ----- Frontend revalidation -----

# Shared secret with the Next.js app for triggering on-demand revalidation.
# Must match `STRAPI_REVALIDATE_SECRET` in apps/ui/.env.local.
STRAPI_REVALIDATE_SECRET=your-revalidate-secret

# ------- Meilisearch -------

# Meilisearch host URL
MEILISEARCH_HOST=

# Master/admin API key used by the Strapi plugin to write indexes.
MEILISEARCH_API_KEY=

# DANGER: Should be false while developing, to not populate production with test data.
# DANGER: If you are not sure always leave false
MEILISEARCH_PRODUCTION=false