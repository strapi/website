# Base URL of the application
# Example:
# - Local development: http://localhost:3000
# - Staging: https://staging.example.com
# - Production: https://www.example.com
BASE_URL=http://localhost:3000
# Enable testing against mobile viewports (true / false)
MOBILE_VIEWPORTS_TESTING_ENABLED=false

# Strapi URL the app under test is configured with (its STRAPI_URL).
# Used by the preview-refresh mock test, which is skipped when unset.
STRAPI_URL=
