    },
    "fallbackTitle": {
      "type": "string",
      "default": "Setting up your demo..."
    },
    "fallbackDescription": {
      "type": "text",
      "default": "You'll receive access details via email shortly."
    },
    "enableRecaptcha": {
      "type": "boolean",
      "default": false
    }
