{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User",
    "name": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "slug": {
      "type": "uid",
      "targetField": "username"
    },
    "avatar": {
      "type": "component",
      "component": "media.image",
      "repeatable": false
    },
    "profilePicture": {
      "type": "component",
      "component": "media.image",
      "repeatable": false
    },
    "description": {
      "type": "text"
    },
    "job": {
      "type": "string"
    },
    "isTeam": {
      "type": "boolean",
      "default": false
    },
    "pronouns": {
      "type": "string"
    },
    "joinedDate": {
      "type": "date"
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city"
    },
    "socials": {
      "type": "component",
      "component": "utilities.social-link",
      "repeatable": true
    }
  }
}
